{
    "name": "tyhpdef/symfony-flex-impl",
    "description": "Implementation package for tyhpdef/symfony-flex. Require tyhpdef/symfony-flex, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.11.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/composer-composer": "@dev",
                "tyhpdef/symfony-finder": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/composer-semver": "@dev",
                "tyhpdef/composer-class-map-generator": "@dev",
                "tyhpdef/react-promise": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-process": "@dev",
                "tyhpdef/seld-jsonlint": "@dev",
                "tyhpdef/nikic-php-parser": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-string": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/php-ext-phar": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-flex"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/flex": "2.11.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/composer-composer": "@dev",
        "tyhpdef/symfony-finder": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/composer-semver": "@dev",
        "tyhpdef/composer-class-map-generator": "@dev",
        "tyhpdef/react-promise": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-process": "@dev",
        "tyhpdef/seld-jsonlint": "@dev",
        "tyhpdef/nikic-php-parser": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-string": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/php-ext-phar": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false
        }
    }
}
